    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@reduxjs/toolkit": "^1.9.5",
    "@sentry/nextjs": "^10.51.0",
    "@tabler/icons-react": "^3.34.1",
    "axios": "^1.4.0",
    "chart.js": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "embla-carousel-react": "^8.6.0",
