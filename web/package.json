    "eslint-config-next": "^16.3.0-canary.11",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^8.0.3",
    "input-otp": "^1.4.2",
    "jest": "^29.6.1",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.55.0",
    "postcss": "8.5.14",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "5.1.6",
    "vaul": "^1.1.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "ip-address": "10.2.0",
    "postcss": "8.5.14"
  }
}
