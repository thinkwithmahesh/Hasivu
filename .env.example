# HASIVU Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values
#
# Docker Compose (docker-compose.dev.yml): JWT_SECRET and JWT_REFRESH_SECRET must be set
# in the shell or in this file before `docker compose up` (Compose uses ${VAR:?...}).

# Node Environment
NODE_ENV=development

# Database Configuration
# Local Docker/Postgres example:
# DATABASE_URL="postgresql://hasivu:dev-only-change-me@localhost:5432/hasivu?schema=public"
# Supabase production runtime URL (pooled app connection):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Supabase direct URL for Prisma migrations:
DIRECT_DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth secrets (32+ chars each)
JWT_SECRET=replace-with-a-unique-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-32-plus-character-secret
# Security hardening toggles
STRICT_SECURITY_MIDDLEWARE=false
ALLOW_UNSAFE_RAW_SQL=false

# Serverless Configuration
SERVERLESS_STAGE=dev

# Lambda Configuration
LAMBDA_FORCE_DISCONNECT=false
